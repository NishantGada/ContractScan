SUPABASE_URL=
SUPABASE_SERVICE_KEY=       # Service role key — never expose this to frontend
LLM_PROVIDER=anthropic      # anthropic | openai — switches the analysis model with no code change
ANTHROPIC_API_KEY=          # required when LLM_PROVIDER=anthropic
OPENAI_API_KEY=             # required when LLM_PROVIDER=openai
ALLOWED_ORIGINS=http://localhost:5173
USE_MOCK_GEMINI=false       # true = skip the LLM API, return fixed sample clause risks (dev/testing only)
